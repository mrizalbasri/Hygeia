# Server-side only, for SSR identity checks and the /api/v1 proxy.
# Set the HTTPS Azure backend origin in Vercel after you configure Azure.
API_BASE_URL=http://127.0.0.1:8080
AUTH_PROVIDER=local
# Use clerk with this public instance key. Never place CLERK_SECRET_KEY here.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Browser requests use the same-origin SvelteKit /api/v1 proxy in dev and Vercel.
# Vercel: AUTH_PROVIDER=clerk and the matching public Clerk instance key.
