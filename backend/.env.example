# Copy to .env. Existing shell environment variables take precedence.
PORT=8080
# Existing Docker PostgreSQL instance: postgres-local, host port 5434.
# Replace the placeholder with your local hygeia_app password.
# sslmode=disable is for local development only.
DATABASE_URL=postgres://hygeia_app:CHANGE_ME@127.0.0.1:5434/hygeia?sslmode=disable
APP_ENV=development
# Generate 32 random bytes and encode as 64 hexadecimal characters.
SESSION_SECRET=CHANGE_ME
AUDIT_HMAC_KEY=CHANGE_ME
# Required only for the development seed command (12+ bytes).
DEMO_PASSWORD=CHANGE_ME
