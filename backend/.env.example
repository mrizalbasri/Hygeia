# Copy to .env. Existing shell environment variables take precedence.
PORT=8080
# Existing Docker PostgreSQL instance: postgres-local, host port 5434.
# Replace the placeholder with your local hygeia_app password.
# sslmode=disable is for local development only.
DATABASE_URL=postgres://hygeia_app:CHANGE_ME@127.0.0.1:5434/hygeia?sslmode=disable
# Use this when running API inside Docker to connect to host Postgres:
DATABASE_URL_DOCKER=postgres://hygeia_app:CHANGE_ME@host.docker.internal:5434/hygeia?sslmode=disable
APP_ENV=development
# Production requires clerk. local is only for development/test demo fixtures.
AUTH_PROVIDER=local
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Exact browser origins, comma separated. No wildcard, credentials, or paths.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Optional actual reverse-proxy networks. Empty: ignore X-Forwarded-For.
# Proxy must overwrite/append XFF using the observed upstream connection IP.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# CarePass QR destination origin. HTTPS required in production.
PUBLIC_APP_URL=http://localhost:5173
# Generate 32 random bytes and encode as 64 hexadecimal characters.
SESSION_SECRET=CHANGE_ME
AUDIT_HMAC_KEY=CHANGE_ME
# Optional: comma-separated historical HMAC keys (64 hex characters each).
# Keep all keys needed to verify older audit records after key rotation.
# AUDIT_HMAC_KEY_PREVIOUS=CHANGE_ME
# Required only for the development seed command (12+ bytes).
DEMO_PASSWORD=CHANGE_ME
