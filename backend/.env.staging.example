# Copy to .env.staging and obtain credentials from the Neon Console.
# These values are placeholders; never commit the real file.
DATABASE_URL=postgresql://hygeia_owner:CHANGE_ME@ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/hygeia_staging?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://hygeia_owner:CHANGE_ME@ENDPOINT.ap-southeast-1.aws.neon.tech/hygeia_staging?sslmode=verify-full
DATABASE_URL_DOCKER=postgresql://hygeia_owner:CHANGE_ME@ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/hygeia_staging?sslmode=verify-full
PORT=8081
# Local API verification only. Public hosting requires production configuration,
# Clerk live keys, HTTPS origins, and independent application secrets.
APP_ENV=development
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=CHANGE_ME
CLERK_SECRET_KEY=CHANGE_ME
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
SESSION_SECRET=CHANGE_ME
AUDIT_HMAC_KEY=CHANGE_ME
