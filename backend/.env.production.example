# Template only. Configure real values in the runtime's secret/environment UI.
# Never build these secrets into the Docker image.
PORT=8080
APP_ENV=production
AUTH_PROVIDER=clerk
DATABASE_URL=postgresql://RUNTIME_ROLE:CHANGE_ME@ENDPOINT-pooler.ap-southeast-1.aws.neon.tech/hygeia_staging?sslmode=verify-full
# Used only by the separate migration command; use a migration-owner role.
DATABASE_URL_UNPOOLED=postgresql://MIGRATION_ROLE:CHANGE_ME@ENDPOINT.ap-southeast-1.aws.neon.tech/hygeia_staging?sslmode=verify-full
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_AUTHORIZED_PARTIES=https://YOUR-FRONTEND.vercel.app
# Exact frontend origin, also used for CSRF and CarePass links.
PUBLIC_APP_URL=https://YOUR-FRONTEND.vercel.app
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS
AUDIT_HMAC_KEY=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS
# Preserve historical audit keys if this database already contains audit events.
# AUDIT_HMAC_KEY_PREVIOUS=
# Configure only the actual proxy networks you control; no wildcard trust.
TRUSTED_PROXY_CIDRS=
